# Power BI Project (PBIP) — .gitignore
# https://learn.microsoft.com/power-bi/developer/projects/projects-overview

# -----------------------------------------------------------------------
# Cache / auto-generated files that Power BI Desktop rewrites on every open
# -----------------------------------------------------------------------

# Dataset cache (binary auto-generated by Desktop)
*.dataset/cache.abf

# Local settings overrides (user-specific connection strings, credentials)
*.pbip.localSettings.json
.localSettings.json

# Desktop / client-side temp files
*.pbix.tmp
*.pbit.tmp

# -----------------------------------------------------------------------
# Report layout — auto-generated / binary blobs inside the report folder
# -----------------------------------------------------------------------

# StaticResources contain bundled JS/CSS that is re-generated on publish
# (include only if you are NOT customising embedded resources)
# *.report/StaticResources/**

# -----------------------------------------------------------------------
# Semantic model (dataset) — files that should NOT be version-controlled
# -----------------------------------------------------------------------

# Model cache written by Desktop at open time (not part of the definition)
*.SemanticModel/.pbi/localSettings.json
*.SemanticModel/.pbi/cache.abf
*.SemanticModel/definition/.platform.bim

# Desktop "do not version" marker files
.pbi/

# -----------------------------------------------------------------------
# Diagramming / layout metadata (optional — remove if you want to track it)
# -----------------------------------------------------------------------
*.SemanticModel/diagramLayout.json

# -----------------------------------------------------------------------
# Build / deployment artefacts
# -----------------------------------------------------------------------

# Compiled .pbix / .pbit files (derive them from source; don't store blobs)
*.pbix
*.pbit

# Deployment pipeline temp output
/deploy/
/dist/
/out/

# -----------------------------------------------------------------------
# Operating-system noise
# -----------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# -----------------------------------------------------------------------
# IDE / editor noise
# -----------------------------------------------------------------------

# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains
.idea/

# -----------------------------------------------------------------------
# Environment / secrets (never commit these)
# -----------------------------------------------------------------------
.env
.env.*
*.env
secrets.json
credentials.json
